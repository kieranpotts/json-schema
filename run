#!/usr/bin/env bash

#
# Run any NPM script in a container named "json-schema" from an image built from
# the Dockerfile in this directory.
#
# Usage:
#   ./run <script> [<script-args>]
#
# Example - to run the tests:
#   ./run test
#

# Immediately exit from this script if any command within it returns a
# non-zero exit status (indicating an error).
#
set -e

# Docker runs on the host only. The workspace devcontainer has no Docker, so
# stop with a clear message there, rather than `docker: command not found`.
#
if ! command -v docker >/dev/null 2>&1; then
  echo "Error: Docker not found. Run this script in a terminal on the host, not in the devcontainer." >&2
  exit 1
fi

# Build a container image from the Dockerfile in the current directory.
# Name the image "json-schema".
#
docker build -t json-schema .

# Run a container in interactive mode (-it) and named "json-schema", built from
# the image "json-schema". Remove (--rm) old containers with the same name, so
# we're not left with a bunch of stopped, unused containers.
#
# In the container, execute `npm run` followed by any arguments passed to
# this script.
#
docker run -it --name json-schema --rm json-schema npm run ${@:1}

# Clean-up containers and images.
#
docker rm -f json-schema
docker rmi -f json-schema
