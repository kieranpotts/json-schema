{
  "$id": "https://kieranpotts.com/schema/v0/country-code.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Country code",
  "description": "Two-letter country code as specified in ISO 3166-1 alpha-2.",
  "type": "string",
  "maxLength": 2,
  "minLength": 2,
  "pattern": "^([A-Z]{2})$"
}
