{
  "$id": "https://kieranpotts.com/schema/v0/date.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Date (no time)",
  "description": "Full date as specified in specified in IETF RFC 3339.",
  "type": "string",
  "minLength": 10,
  "maxLength": 10,
  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[1-2][0-9]|3[0-1])$"
}
