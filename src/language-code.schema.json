{
  "$id": "https://kieranpotts.com/schema/v0/language-code.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Language code",
  "description": "Language tag, as specified in IETF BCP-47.",
  "type": "string",
  "maxLength": 10,
  "minLength": 2,
  "pattern": "^[a-z]{2}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}))?$"
}
