{
  "$id": "https://kieranpotts.com/schema/v0/time.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Time (no date)",
  "description": "A time value in a format specified in IETF RFC 3339.",
  "type": "string",
  "minLength": 9,
  "maxLength": 64,
  "pattern": "^([0-1][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
}
