{
  "$id": "https://kieranpotts.com/uuid.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UUID",
  "description": "A UUID in the format defined in IETF RFC 4122 (https://tools.ietf.org/html/rfc4122).",
  "type": "string",
  "minLength": 36,
  "maxLength": 36,
  "pattern": "^[0-9a-zA-Z]{8}-[0-9a-zA-Z]{4}-[0-9a-zA-Z]{4}-[0-9a-zA-Z]{4}-[0-9a-zA-Z]{12}$"
}
